# Copiar este archivo a .env y completar los valores reales.
# .env NUNCA se sube al repo (está en .gitignore).

# --- Base de datos (Neon) ---
# Dashboard -> Connect -> connection string (apagar "Agrupación de conexiones").
# Ejemplo: postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Seguridad / JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Administrador inicial (lo crea `python -m app.seed`) ---
FIRST_ADMIN_EMAIL=admin@fashionstore.com
FIRST_ADMIN_PASSWORD=Admin123!
FIRST_ADMIN_NOMBRE=Administrador
FIRST_ADMIN_APELLIDO=General

# --- CORS: orígenes del frontend permitidos (separados por coma) ---
CORS_ORIGINS=http://localhost:4200

# --- Stripe (modo test) — Dashboard -> Developers -> API keys ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- URL pública del frontend (a dónde vuelve el cliente tras pagar) ---
FRONTEND_URL=http://localhost:4200
